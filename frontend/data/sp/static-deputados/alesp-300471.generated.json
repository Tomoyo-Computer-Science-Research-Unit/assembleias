cao_id":"alesp:20190327-180744-ID-SESSAO-13638","voto":"sim"}],"proposicoes":[{"id":"PEC-3/2022","tipo":"PEC","numero":"3","ano":2022,"ementa":"Dá nova redação ao parágrafo 1º do artigo 167 da Constituição do Estado de São Paulo.","data":"2022-10-27"},{"id":"PLC-43/2022","tipo":"PLC","numero":"43","ano":2022,"ementa":"Revoga o §2º do artigo 9º da Lei Complementar nº 1.012, de 5 de julho de 2007, que altera a Lei Complementar nº 180, de 12 de maio de 1978, a Lei nº 10.261, de 28 de outubro de 1968, a Lei Complementar nº 207, de 5 de janeiro de 1979, e dá providências correlatas.","data":"2022-10-19"},{"id":"PLC-42/2022","tipo":"PLC","numero":"42","ano":2022,"ementa":"Autoriza o Poder Executivo a prorrogar por mais um ano a vigência dos contratos dos docentes firmados nos termos da Lei Complementar nº 1093, de 16 de julho de 2009, e que vencerem ao longo de 2022.","data":"2022-10-19"},{"id":"PL-53/2022","tipo":"PL","numero":"53","ano":2022,"ementa":"Institui o \"Dia do Tutor da Vizinhança Solidária\".","data":"2022-02-11"},{"id":"PL-52/2022","tipo":"PL","numero":"52","ano":2022,"ementa":"Denomina \"Antônio Manoel de Oliveira\" a perimetral que liga a intersecção da Rodovia Romildo Prado - SP 063 com a Rodovia Engenheiro Constâncio Cintra - SP 360 à Rodovia Dom Pedro I - SP 065, em Itatiba.","data":"2022-02-11"},{"id":"MOC-13/2022","tipo":"MOC","numero":"13","ano":2022,"ementa":"Apela ao Sr. Presidente do Conselho Nacional de Justiça a fim de que empreenda esforços para que seja prorrogado por 06 (seis) meses o prazo de validade do concurso de Escrevente Técnico Judiciário e seja expedida nova recomendação para garantir a suspensão dos prazos dos concursos vigentes até 31 de dezembro de 2022, posto que a pandemia ainda não foi superada.","data":"2022-02-11"},{"id":"MOC-12/2022","tipo":"MOC","numero":"12","ano":2022,"ementa":"Apela ao Sr. Desembargador Presidente do Tribunal de Justiça do Estado de São Paulo a fim de que prorrogue por 06 (seis) meses o prazo de validade do concurso de Escrevente Técnico Judiciário e suspenda os prazos dos concursos vigentes até 31 de dezembro de 2022, posto que a pandemia ainda não foi superada.","data":"2022-02-11"},{"id":"MOC-315/2021","tipo":"MOC","numero":"315","ano":2021,"ementa":"Repudia as ofensas desferidas pelo deputado estadual Frederico d'Avila contra o Papa Francisco, o Arcebispo de Aparecida, Dom Orlando Brandes, e contra a Conferência Nacional dos Bispos do Brasil - CNBB, e manifesta respeito e solidariedade, declarando que tais agressões não expressam o pensamento da maioria dos parlamentares desta Casa.","data":"2021-10-20"},{"id":"PL-708/2021","tipo":"PL","numero":"708","ano":2021,"ementa":"Denomina \"Anderson Martins Furlan\" a ciclovia que interliga Pirassununga ao Distrito de Cachoeira de Emas, localizada na Rodovia Rubens Fernandes de Ávila - SP 211.","data":"2021-10-19"},{"id":"PR-24/2021","tipo":"PR","numero":"24","ano":2021,"ementa":"Cria a Comissão Parlamentar de Inquérito destinada a investigar e apurar as práticas adotadas pela empresa de planos de saúde \"Prevent Senior\" no tratamento de pacientes acometidos de Covid-19, bem como os supostos crimes cometidos ao longo da Pandemia de Covid-19.","data":"2021-09-28"},{"id":"MOC-110/2021","tipo":"MOC","numero":"110","ano":2021,"ementa":"Manifesta solidariedade à família do Prefeito Municipal de São Paulo, Bruno Covas Lopes, bem como à classe política e a toda a população profundamente consternada pela sua morte.","data":"2021-05-18"},{"id":"PEC-4/2021","tipo":"PEC","numero":"4","ano":2021,"ementa":"Acrescenta o item 19 ao artigo 23, altera o inciso II do artigo 74 e o § 2º do artigo 139 e acrescenta o artigo 143-A à Constituição do Estado.","data":"2021-02-25"},{"id":"PEC-3/2021","tipo":"PEC","numero":"3","ano":2021,"ementa":"Inclui o artigo 137-A à Constituição do Estado.","data":"2021-02-16"},{"id":"PEC-2/2021","tipo":"PEC","numero":"2","ano":2021,"ementa":"Acrescenta o inciso VI ao artigo 266 da Constituição do Estado.",